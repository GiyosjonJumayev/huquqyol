# Claude API kaliti (https://console.anthropic.com). Bo‘lmasa ilova qidiruv+qoidalar rejimida ishlaydi.
ANTHROPIC_API_KEY=
# Model (tez va arzon: claude-haiku-5-5; aniqroq: claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-haiku-5-5
# Markaziy bank asosiy stavkasi, % (333-modda kompensatsiyasi uchun)
CB_RATE=14
PORT=3000
# Reverse proxy ortida (Render, Nginx): 1
TRUST_PROXY=
# Faqat HTTPS serverda yoqing (HSTS va upgrade-insecure-requests):
# NODE_ENV=production
