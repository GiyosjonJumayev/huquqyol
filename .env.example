# HuquqYo‘l sozlamalari. Bu faylni .env nomi bilan nusxalang va to‘ldiring (chmod 600 .env).
# Hosting panelida (cPanel «Environment variables», Render, Docker) berilgan qiymatlar .env dan ustun turadi.

# Claude API kaliti (https://console.anthropic.com). Bo‘sh bo‘lsa ilova qidiruv+qoidalar rejimida ishlaydi.
ANTHROPIC_API_KEY=
# Model (tez va arzon: claude-haiku-5-5; aniqroq: claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-haiku-5-5

# AI provayderi: anthropic yoki gemini. Bo‘sh — kaliti berilgani (ikkalasi bo‘lsa — anthropic).
# Ikkala kalit ham bo‘sh bo‘lsa — AI o‘chiq, qidiruv+qoidalar rejimi (davlat joylashtiruvi uchun tavsiya).
AI_PROVIDER=
# Google Gemini API kaliti (https://aistudio.google.com → Get API key). AIza... yoki AQ... ko‘rinishida.
# Faqat serverda ishlatiladi: brauzerga yuborilmaydi, URL ga qo‘yilmaydi, logga yozilmaydi.
GEMINI_API_KEY=
# Model nomi — AI Studio’dagi kabi
GEMINI_MODEL=gemini-4-hydrogen
# Fikrlash darajasi: minimal | low | medium | high | son (token byudjeti) | off. Bo‘sh — eng past daraja (tezlik uchun).
GEMINI_THINKING=

# Telegram bot tokeni (@BotFather → /newbot). Faqat «npm run bot» uchun kerak; sayt usiz ishlaydi.
TELEGRAM_BOT_TOKEN=
# Bot havolasi (footer, Maxfiylik): https://t.me/nom yoki @nom; bo‘sh — kodda yozilgan @huquq_yol_bot
TELEGRAM_BOT_URL=

# Markaziy bank asosiy stavkasi, % (MK 333-modda kompensatsiyasi uchun)
CB_RATE=14
# Bir bola uchun eng kam aliment, so‘m (2026-yil 1-sentabrdan)
MIN_ALIMONY=360400
# Qo‘shimcha ishlanmaydigan kunlar (MK 9-modda muddatlari uchun), YYYY-MM-DD, vergul bilan.
# Ramazon/Qurbon hayiti sanalarini faqat rasmiy e’londan keyin yozing (masalan 2027-yil uchun). Doimiy bayramlar kodda bor.
HOLIDAYS_EXTRA=

# Port. cPanel/Passenger va Render portni o‘zi beradi — u yerda yozmang.
PORT=3000
# VPS’da faqat Nginx orqali ochish uchun: 127.0.0.1
HOST=
# Proxy ortida (Nginx, cPanel/Apache, Render, Cloudflare): 1 — haqiqiy IP va HTTPS aniqlanadi
TRUST_PROXY=1
# SSL ishlayotgan bo‘lsa: http so‘rovlarni https ga yo‘naltirish
FORCE_HTTPS=
# Sayt domeni (masalan huquqyol.uz). Berilsa, https yo‘naltirish faqat shu domenga bo‘ladi (soxta Host himoyasi)
PUBLIC_HOST=
# Anonim statistika (faqat holatlar bo‘yicha sanoqlar; matn va IP saqlanmaydi). 0 — o‘chirish
STATS=
# Statistika fayli (default: ilova papkasidagi data/stats.json)
STATS_FILE=
# Hujjat rasmidan o‘qish (bepul OCR, AI kalitisiz ham ishlaydi). 0 — o‘chirish
OCR=
# OCR til fayllari nusxalanadigan papka (default: tizim vaqtinchalik papkasi). Yozish mumkin bo‘lishi kerak
OCR_DATA_DIR=
NODE_ENV=production
# Vaqt mintaqasi: muddatlar va «bugun» Toshkent vaqti bo‘yicha (UTC serverda tunda «kelajakdagi sana» xatosi bo‘lmasligi uchun)
TZ=Asia/Tashkent

# ---------- Hisoblar, obunalar, kelishuvlar (PostgreSQL) ----------
# Bo‘sh bo‘lsa sayt bazasiz ishlaydi (fuqaro oqimi to‘liq), faqat kirish/ro‘yxat, obuna va admin paneli o‘chiq.
# Masalan: postgres://huquqyol:PAROL@127.0.0.1:5432/huquqyol   (Render/Neon kabi bulutda: ?sslmode=require)
# Jadvallar ilova ishga tushganda avtomatik yaratiladi (migratsiyalar).
DATABASE_URL=
# Admin bo‘ladigan e-pochtalar (vergul bilan). Shu e-pochta bilan ro‘yxatdan o‘tgan yoki kirgan foydalanuvchi — admin.
ADMIN_EMAILS=
# Kelishuv (konsultatsiya) summasidan platforma komissiyasi, %
COMMISSION_PCT=10
# Sessiya muddati, kun
SESSION_DAYS=30
# Kirish/ro‘yxat urinishlari: IP uchun daqiqasiga
AUTH_RATE=10

# ---------- Production xavfsizligi ----------
# 2FA kalitlarini shifrlash uchun tasodifiy satr (kamida 32 belgi). Yo‘qolsa, 2FA qayta sozlanadi — zaxirasini saqlang.
APP_SECRET=
# Docker Compose bazasi paroli (faqat harf va raqam: URL ichida ishlatiladi)
POSTGRES_PASSWORD=
# Admin paneli uchun ikki bosqichli kirish (production’da majburiy; 0 — o‘chirish, tavsiya etilmaydi)
REQUIRE_ADMIN_2FA=
# Namuna (DEMO) yurist profillari: 1 — ko‘rsatish (faqat namoyish serverida)
SHOW_DEMO=
# Xat yuborish: parolni tiklash, e-pochtani tasdiqlash, taklif, eslatma
SMTP_URL=
MAIL_FROM=HuquqYo‘l <no-reply@huquqyol.uz>

# ---------- To‘lovlar (docs/PAYMENTS.md) ----------
PAYME_MERCHANT_ID=
PAYME_KEY=
# 1 — test.paycom.uz (sinov); ishchi rejimda bo‘sh qoldiring
PAYME_TEST=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
# Rekvizitlar: oferta va hisob-faktura (bank o‘tkazmasi)
COMPANY_NAME=
COMPANY_INN=
COMPANY_ADDRESS=
COMPANY_BANK=
COMPANY_ACCOUNT=
COMPANY_MFO=
COMPANY_PHONE=
COMPANY_EMAIL=
# Fiskal chek (Payme): tasnif.soliq.uz dagi IKPU va qadoq kodi, QQS foizi
FISCAL_IKPU=
FISCAL_PACKAGE_CODE=
FISCAL_VAT=
# Narxlar (so‘m) va chegirmalar (%). Bo‘sh — standart: 149000 / 490000, chegirmasiz
PRICE_PRO=
PRICE_FIRMA=
PLAN_DISCOUNT_3=
PLAN_DISCOUNT_12=
FIRMA_SEATS=
ORG_SEATS=
