# HuquqYo‘l sozlamalari. Bu faylni .env nomi bilan nusxalang va to‘ldiring (chmod 600 .env).
# Hosting panelida (cPanel «Environment variables», Render, Docker) berilgan qiymatlar .env dan ustun turadi.

# Claude API kaliti (https://console.anthropic.com). Bo‘sh bo‘lsa ilova qidiruv+qoidalar rejimida ishlaydi.
ANTHROPIC_API_KEY=
# Model (tez va arzon: claude-haiku-5-5; aniqroq: claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-haiku-5-5

# Markaziy bank asosiy stavkasi, % (MK 333-modda kompensatsiyasi uchun)
CB_RATE=14
# Bir bola uchun eng kam aliment, so‘m (2026-yil 1-sentabrdan)
MIN_ALIMONY=360400

# Port. cPanel/Passenger va Render portni o‘zi beradi — u yerda yozmang.
PORT=3000
# VPS’da faqat Nginx orqali ochish uchun: 127.0.0.1
HOST=
# Proxy ortida (Nginx, cPanel/Apache, Render, Cloudflare): 1 — haqiqiy IP va HTTPS aniqlanadi
TRUST_PROXY=1
# SSL ishlayotgan bo‘lsa: http so‘rovlarni https ga yo‘naltirish
FORCE_HTTPS=
NODE_ENV=production
