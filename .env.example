# HuquqYo‘l sozlamalari. Bu faylni .env nomi bilan nusxalang va to‘ldiring (chmod 600 .env).
# Hosting panelida (cPanel «Environment variables», Render, Docker) berilgan qiymatlar .env dan ustun turadi.

# Claude API kaliti (https://console.anthropic.com). Bo‘sh bo‘lsa ilova qidiruv+qoidalar rejimida ishlaydi.
ANTHROPIC_API_KEY=
# Model (tez va arzon: claude-haiku-5-5; aniqroq: claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-haiku-5-5

# Telegram bot tokeni (@BotFather → /newbot). Faqat «npm run bot» uchun kerak; sayt usiz ishlaydi.
TELEGRAM_BOT_TOKEN=

# Markaziy bank asosiy stavkasi, % (MK 333-modda kompensatsiyasi uchun)
CB_RATE=14
# Bir bola uchun eng kam aliment, so‘m (2026-yil 1-sentabrdan)
MIN_ALIMONY=360400
# Qo‘shimcha ishlanmaydigan kunlar (MK 9-modda muddatlari uchun), YYYY-MM-DD, vergul bilan.
# Ramazon/Qurbon hayiti sanalarini faqat rasmiy e’londan keyin yozing (masalan 2027-yil uchun). Doimiy bayramlar kodda bor.
HOLIDAYS_EXTRA=

# Port. cPanel/Passenger va Render portni o‘zi beradi — u yerda yozmang.
PORT=3000
# VPS’da faqat Nginx orqali ochish uchun: 127.0.0.1
HOST=
# Proxy ortida (Nginx, cPanel/Apache, Render, Cloudflare): 1 — haqiqiy IP va HTTPS aniqlanadi
TRUST_PROXY=1
# SSL ishlayotgan bo‘lsa: http so‘rovlarni https ga yo‘naltirish
FORCE_HTTPS=
# Sayt domeni (masalan huquqyol.uz). Berilsa, https yo‘naltirish faqat shu domenga bo‘ladi (soxta Host himoyasi)
PUBLIC_HOST=
# Anonim statistika (faqat holatlar bo‘yicha sanoqlar; matn va IP saqlanmaydi). 0 — o‘chirish
STATS=
# Statistika fayli (default: ilova papkasidagi data/stats.json)
STATS_FILE=
# Hujjat rasmidan o‘qish (bepul OCR, AI kalitisiz ham ishlaydi). 0 — o‘chirish
OCR=
# OCR til fayllari nusxalanadigan papka (default: tizim vaqtinchalik papkasi). Yozish mumkin bo‘lishi kerak
OCR_DATA_DIR=
NODE_ENV=production
# Vaqt mintaqasi: muddatlar va «bugun» Toshkent vaqti bo‘yicha (UTC serverda tunda «kelajakdagi sana» xatosi bo‘lmasligi uchun)
TZ=Asia/Tashkent

# ---------- Hisoblar, obunalar, kelishuvlar (PostgreSQL) ----------
# Bo‘sh bo‘lsa sayt bazasiz ishlaydi (fuqaro oqimi to‘liq), faqat kirish/ro‘yxat, obuna va admin paneli o‘chiq.
# Masalan: postgres://huquqyol:PAROL@127.0.0.1:5432/huquqyol   (Render/Neon kabi bulutda: ?sslmode=require)
# Jadvallar ilova ishga tushganda avtomatik yaratiladi (migratsiyalar).
DATABASE_URL=
# Admin bo‘ladigan e-pochtalar (vergul bilan). Shu e-pochta bilan ro‘yxatdan o‘tgan yoki kirgan foydalanuvchi — admin.
ADMIN_EMAILS=
# Kelishuv (konsultatsiya) summasidan platforma komissiyasi, %
COMMISSION_PCT=10
# Sessiya muddati, kun
SESSION_DAYS=30
# Kirish/ro‘yxat urinishlari: IP uchun daqiqasiga
AUTH_RATE=10
